ENV=local
DATABASE_URL=postgresql+asyncpg://visacrm:visacrm@localhost:5432/visacrm
SECRET_KEY=change-me
# 32 random bytes, base64. Generate: uv run python -m app.cli generate-master-key
# Rotation: docs/operations.md
VAULT_MASTER_KEY=
VAULT_MASTER_KEY_PREVIOUS=
# Outgoing mail. Locally: Mailpit from docker compose catches every letter,
# read them at http://localhost:8025. Empty SMTP_HOST: letters are printed to the console.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=none
MAIL_FROM=VisaCRM <no-reply@visacrm.local>
