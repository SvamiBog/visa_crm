# local | test | staging | production, in any case. Unset means production; any other
# value stops the start.
ENV=local
DATABASE_URL=postgresql+asyncpg://visacrm:visacrm@localhost:5432/visacrm
# Outside ENV=local|test: at least 32 random characters, or the app does not start.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# 32 random bytes, base64. Generate: uv run python -m app.cli generate-master-key
# Rotation: docs/operations.md
VAULT_MASTER_KEY=
VAULT_MASTER_KEY_PREVIOUS=
# Outgoing mail. Locally: Mailpit from docker compose catches every letter,
# read them at http://localhost:8025. Empty SMTP_HOST: letters are printed to the console.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=none
MAIL_FROM=VisaCRM <no-reply@visacrm.local>
# Files of consents and contracts: any S3-compatible storage in the EU. Empty S3_BUCKET:
# locally the files are kept in memory until the server restarts.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Error reports to Sentry (docs/deploy.md, step 4). Empty: the SDK does not start and
# nothing is sent; keep it empty on a developer's machine.
SENTRY_DSN=
# The client bot in Telegram (docs/deploy.md, step 4). Empty: there is no bot and the
# webhook answers 404; keep both empty on a developer's machine. The token comes from
# @BotFather; the secret is any 32+ characters of A-Z, a-z, 0-9, _ and -.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
